formulas:
  Date: file.ctime.date()
properties:
  note.date created:
    displayName: Date Created
views:
  - type: table
    name: Table
    filters:
      and:
        - file.folder == "content/Zenith CH750 Cruzer/Build/Empennage"
    order:
      - date created
      - file.name
      - Time (Hours)
      - Description
    sort:
      - property: date created
        direction: ASC
      - property: formula.Date
        direction: DESC
    summaries:
      Time (Hours): Sum
    columnSize:
      formula.Date: 111
